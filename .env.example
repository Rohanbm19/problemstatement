# TwinStock AI - Environment Configuration Example

# Backend Database URL (Defaults to SQLite if unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/twinstock_db
DATABASE_URL=sqlite:///./app.db

# ML Service URL for forecast predictions
ML_SERVICE_URL=http://127.0.0.1:8001

# Allowed Origins for CORS (comma-separated or *)
ALLOWED_ORIGINS=*

# Frontend Proxy Target
BACKEND_URL=http://127.0.0.1:8000
